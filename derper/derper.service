[Unit]
Description=Tailscale DERP relay (self-hosted)
After=network.target

[Service]
ExecStart=/opt/derper/gopath/bin/derper \
  -hostname=derp.example.com \
  -a :8443 \
  -stun \
  -certmode manual \
  -certdir /opt/derper/certs \
  -http-port -1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
